# Kopieren nach .env und ausfüllen. .env NICHT committen.

# --- Domain / TLS / Ports -------------------------------------------------
DOMAIN=agent-dashboard.local
# Extern veröffentlichte Ports (übersteuern, wenn auf dem Host schon belegt):
#EXTERNAL_HTTPS_PORT=8443
#EXTERNAL_HTTP_PORT=8080

# --- LLM-Provider ---------------------------------------------------------
# ORCH_PROVIDER schaltet den Orchestrator-Provider: anthropic (Default) | ollama
ORCH_PROVIDER=anthropic
ANTHROPIC_API_KEY=                       # nur für ORCH_PROVIDER=anthropic nötig
# Modell des Providers. Im Dashboard (Einstellungen) live übersteuerbar.
#ORCH_MODEL=claude-opus-4-8
# Ollama braucht KEINEN API-Key. base_url auf deine Ollama-Instanz zeigen.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud          # Tool-fähiges Modell (z.B. gpt-oss, deepseek-v3.1)
# Aus einem Container heraus ist localhost = der Container; dann den Host
# adressieren, z.B. OLLAMA_BASE_URL=http://host.docker.internal:11434
#OLLAMA_TIMEOUT=180                      # Sekunden je Antwort
# Obergrenze für Tool-Runden je Nutzer-Eingabe und Zeichen je Tool-Ergebnis
# (letzteres deckelt, was dauerhaft in der History mitfährt):
#ORCH_MAX_TOOL_ROUNDS=25
#ORCH_MAX_TOOL_RESULT=30000

# --- Integrationen --------------------------------------------------------
# Timeout für call_integration in Sekunden (Default 60, Verbindungsaufbau
# fix 15 s); je Integration per `timeout:` in integrations.yaml übersteuerbar.
# Lange Vorgänge asynchron anstoßen statt das Timeout hochzudrehen (#34).
#INTEGRATION_TIMEOUT=60
# Wie viele Integrations-Aufrufe parallel laufen dürfen (eigener Threadpool).
#MCP_INTEGRATION_PARALLEL=4

# --- Agenten: MCP-Tunnel + Automatikmodus ---------------------------------
# Reverse-SSH-Tunnel, der den Container-MCP auf die Agenten-PCs bringt.
# Ohne diesen Schalter läuft der Tunnel-Prozess gar nicht erst an.
#MCP_TUNNEL_ENABLED=true
# Sanftes Ausschalten der Automatik: so lange darf ein laufender claude-Lauf
# noch fertig werden, bevor der Watcher hart beendet wird (Sekunden).
#AUTO_STOP_GRACE=1860
# Not-Aus: Wartezeit auf das Prozessende nach dem "kill"-Kommando (Sekunden).
#AUTO_KILL_GRACE=5
# Remote-Port des Reverse-Tunnels auf dem Agenten-PC (Default = MCP_PORT).
#MCP_TUNNEL_REMOTE_PORT=9000

# --- Zeitpläne (Paket St.2) ------------------------------------------------
# Tick-Takt des Planers und Kulanz für knapp verpasste Termine (Sekunden).
# Ohne `nachholen:` am Plan verfällt ein Termin, der älter als die Kulanz ist.
#PLANER_INTERVALL=30
#PLANER_KULANZ=600

# --- Mailbox-Pflege -------------------------------------------------------
# Wie oft aufgeräumt wird, ab wann ein Task in .processing als verwaist gilt
# (Watcher gestorben -> zurück in die Warteschlange) und wie lange Archiv,
# Fehlschläge und Outbox-Antworten aufgehoben werden. Alles in Sekunden bzw.
# Tagen.
#MAILBOX_PFLEGE_INTERVALL=900
#MAILBOX_STALE_ALTER=10800
#MAILBOX_ARCHIV_TAGE=30
# Zusätzlich alte response/answer aus der INBOX ins Archiv (Issue #21);
# Tasks und offene Fragen bleiben unangetastet. 0 = aus.
#MAILBOX_INBOX_TAGE=14

# --- Terminal -------------------------------------------------------------
# Wie lange eine SSH-Terminal-Session ohne verbundenen Client weiterläuft,
# in Sekunden (Fenster zu / Browser zu / anderer PC). 0 = unbegrenzt.
# Ein Container-Restart beendet Sessions trotzdem (sie leben im API-Prozess).
#SSH_GRACE_SECONDS=86400

# --- Auth -----------------------------------------------------------------
# Das Admin-Passwort. Es wird bei JEDEM Login direkt aus dieser Datei gelesen
# (nichts wird persistiert oder gehasht) — ändern = hier ändern + neu starten.
# Leer lassen heißt: die API ist ohne Login offen (nur für Dev gedacht).
ADMIN_INITIAL_PASSWORD=
# Zufälliger Wert, mit dem Session-Cookies signiert werden, z.B.
#   openssl rand -hex 32
# Unbedingt setzen: sonst wird das Secret aus dem Passwort abgeleitet, und ein
# geleaktes Cookie erlaubt einen Offline-Angriff auf das Passwort. Ändern
# entwertet alle bestehenden Sessions (einmal neu anmelden).
SESSION_SECRET=
