# Kopieren nach .env und ausfüllen. .env NICHT committen.

# --- Domain / TLS ---------------------------------------------------------
DOMAIN=agent-dashboard.local

# --- LLM-Provider ---------------------------------------------------------
# ORCH_PROVIDER schaltet den Orchestrator-Provider: anthropic (Default) | ollama
ORCH_PROVIDER=anthropic
ANTHROPIC_API_KEY=                       # nur für ORCH_PROVIDER=anthropic nötig
OPENROUTER_API_KEY=
# Ollama braucht KEINEN API-Key. base_url auf deine Ollama-Instanz zeigen.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud          # Tool-fähiges Modell (z.B. gpt-oss, deepseek-v3.1)
# Aus einem Container heraus ist localhost = der Container; dann den Host
# adressieren, z.B. OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Telegram (optionaler zweiter Eingangskanal) --------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Auth -----------------------------------------------------------------
# Initiales Admin-Passwort nur für den ersten Start; danach in DB gehasht.
ADMIN_INITIAL_PASSWORD=
SESSION_SECRET=
