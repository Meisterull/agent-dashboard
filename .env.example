# Kopieren nach .env und ausfüllen. .env NICHT committen.

# --- Domain / TLS / Ports -------------------------------------------------
DOMAIN=agent-dashboard.local
# Extern veröffentlichte Ports (übersteuern, wenn auf dem Host schon belegt):
#EXTERNAL_HTTPS_PORT=8443
#EXTERNAL_HTTP_PORT=8080

# --- LLM-Provider ---------------------------------------------------------
# ORCH_PROVIDER schaltet den Orchestrator-Provider: anthropic (Default) | ollama
ORCH_PROVIDER=anthropic
ANTHROPIC_API_KEY=                       # nur für ORCH_PROVIDER=anthropic nötig
OPENROUTER_API_KEY=
# Ollama braucht KEINEN API-Key. base_url auf deine Ollama-Instanz zeigen.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud          # Tool-fähiges Modell (z.B. gpt-oss, deepseek-v3.1)
# Aus einem Container heraus ist localhost = der Container; dann den Host
# adressieren, z.B. OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Telegram (optionaler zweiter Eingangskanal) --------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Integrationen --------------------------------------------------------
# Timeout für call_integration in Sekunden (Default 600, Verbindungsaufbau
# fix 15 s); je Integration per `timeout:` in integrations.yaml übersteuerbar.
#INTEGRATION_TIMEOUT=600

# --- Terminal -------------------------------------------------------------
# Wie lange eine SSH-Terminal-Session ohne verbundenen Client weiterläuft,
# in Sekunden (Fenster zu / Browser zu / anderer PC). 0 = unbegrenzt.
# Ein Container-Restart beendet Sessions trotzdem (sie leben im API-Prozess).
#SSH_GRACE_SECONDS=86400

# --- Auth -----------------------------------------------------------------
# Initiales Admin-Passwort nur für den ersten Start; danach in DB gehasht.
ADMIN_INITIAL_PASSWORD=
SESSION_SECRET=
